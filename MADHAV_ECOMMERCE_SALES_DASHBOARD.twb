      <aliases enabled='yes' />
      <column caption='Order Date (Parsed)' datatype='date' name='[Calculation_445011987960721409]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATE(STR([Order Date]))' />
      </column>
      <column caption='Order Year' datatype='integer' name='[Calculation_445011987962707971]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([Calculation_445011987960721409])' />
      </column>
      <column caption='Order Month Name' datatype='string' name='[Calculation_445011987962798084]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [Calculation_445011987960721409])' />
      </column>
      <column caption='Order Month (Number)' datatype='integer' name='[Calculation_445011987962871813]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;month&apos;, [Calculation_445011987960721409])' />
      </column>
      <column caption='Order Quarter' datatype='integer' name='[Calculation_445011987963011078]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEPART(&apos;quarter&apos;, [Calculation_445011987960721409])' />
      </column>
      <column caption='Order Total (LOD)' datatype='integer' name='[Calculation_445011987963056135]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Order ID] : SUM([Amount]) }' />
      </column>
      <column caption='Quantity %' datatype='real' name='[Calculation_445011987963224073]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Quantity]) / WINDOW_SUM(SUM([Quantity]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='AOV' datatype='real' name='[Calculation_445011987967946762]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Amount]) / COUNTD([Order ID])' />
      </column>
      <column caption='PROFIT SIGN' datatype='string' name='[Calculation_445011987991666701]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &lt; 0 THEN &quot;Negative&quot; ELSE &quot;Positive&quot; END' />
      </column>
      <column caption='ORDER QUATER' datatype='string' name='[Calculation_445011987993677838]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;,[Order Date]))' />
      </column>
